---
import css from "../styles/global.css?inline";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_URL, BRAND } from "../config";
import { ROUTES, type Lang, type PageKey } from "../i18n/routes";
import { site } from "../i18n/site";

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
}
const { lang, page, title, description, jsonLd = [], noindex = false, ogImage } = Astro.props;
const t = site[lang];
const other: Lang = lang === "nl" ? "en" : "nl";
const canonical = new URL(ROUTES[page][lang], SITE_URL).href;
const alternates = { nl: new URL(ROUTES[page].nl, SITE_URL).href, en: new URL(ROUTES[page].en, SITE_URL).href };
const og = new URL(ogImage ?? `/og/${page}-${lang}.png`, SITE_URL).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="nl" href={alternates.nl} />
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="x-default" href={alternates.nl} />
      </>
    )}
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content="Kevin, Kevin Rebuilds" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={site[other].locale} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={css}></style>

    <!-- Runs before paint: enables JS-only enhancements and forwards old ?lang= links. -->
    <script is:inline define:vars={{ lang, alt: ROUTES[page] }}>
      document.documentElement.classList.add("js");
      try {
        var p = new URLSearchParams(location.search).get("lang");
        if ((p === "en" || p === "nl") && p !== lang) location.replace(alt[p] + location.hash);
      } catch (e) {}
    </script>
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
