export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  size?: number;
}
const { name, class: className, label, size } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={ICONS[name]}
/>
