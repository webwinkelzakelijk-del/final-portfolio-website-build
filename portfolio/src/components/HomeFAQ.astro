---
import Icon from "./Icon.astro";
import { ANCHORS, type Lang } from "../i18n/routes";
import { site } from "../i18n/site";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = site[lang].faq;
---
<section class="section home-faq" id={ANCHORS[lang].faq} aria-labelledby="home-faq-title">
  <div class="container faq-grid">
    <div class="home-faq-intro">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="home-faq-title" class="h2 h2--sm">{t.title}</h2>
      <p>{t.intro}</p>
      <a class="text-link" href={`#${ANCHORS[lang].request}`}>{t.cta}<Icon name="arrow-right" /></a>
    </div>
    <div class="faq-list">
      {t.items.map(([question, answer]) => (
        <details class="faq-item">
          <summary><h3>{question}</h3><span class="faq-icon" aria-hidden="true"><Icon name="plus" /></span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
