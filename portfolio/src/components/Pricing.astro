---
import Icon, { type IconName } from "./Icon.astro";
import { ANCHORS, type Lang } from "../i18n/routes";
import { site } from "../i18n/site";
import { PRICES, formatPrice } from "../config";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = site[lang].pricing;
const items: { key: "website" | "webapp" | "automation"; icon: IconName }[] = [
  { key: "website", icon: "globe" },
  { key: "webapp", icon: "bars" },
  { key: "automation", icon: "cog" },
];
---

<section class="section section--tint pricing" id={ANCHORS[lang].pricing} aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="pricing-title" class="h2">{t.title}</h2>
      <p class="lead">{t.intro}</p>
    </div>

    <ul class="price-cards">
      {items.map(({ key, icon }) => {
        const price = PRICES[key];
        const c = t.cards[key];
        return (
          <li class="price-card">
            <span class="icon-tile"><Icon name={icon} /></span>
            <h3>{c.title}</h3>
            <p class="price">
              {price === null ? (
                <strong>{t.onRequest}</strong>
              ) : (
                <>
                  <span class="price-from">{t.from}</span>
                  <strong>{formatPrice(price, lang)}</strong>
                  <span class="price-vat">{t.exVat}</span>
                </>
              )}
            </p>
            <p class="price-text">{c.text}</p>
            <a class="text-link" href={`#${ANCHORS[lang].request}`} data-service={key}>
              {c.cta}<Icon name="arrow-right" />
            </a>
          </li>
        );
      })}
    </ul>

    <div class="price-factors">
      <h3>{t.factorsTitle}</h3>
      <ul class="check-list">
        {t.factors.map((f) => <li><Icon name="check" />{f}</li>)}
      </ul>
      <p>{t.note}</p>
    </div>
  </div>
</section>
