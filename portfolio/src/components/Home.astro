---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { dict, EMAIL, FIVERR, type Lang } from "../i18n/content";
import head from "../assets/kevin-head.webp";
import differentHair from "../assets/different-hair.png";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dict[lang];
const home = lang === "nl" ? "/" : "/en/";
const year = new Date().getFullYear();
const serviceViz = ["browser", "app", "flow"];
const whyIcons: Record<string, "user" | "zap" | "phone" | "search" | "heart" | "languages"> = {
  direct: "user",
  speed: "zap",
  mobile: "phone",
  seo: "search",
  honest: "heart",
  bilingual: "languages",
};
const [whyDirect, whySpeed, whyMobile, whySeo, whyHonest, whyLang] = t.why.cards;
const searchPhrase = lang === "nl" ? "webdesigner in drenthe" : "freelance web developer";
---

<a class="skip-link" href="#main">{t.skip}</a>
<div class="grain" aria-hidden="true"></div>

<!-- Custom cursor (fine pointers only) -->
<div class="cursor is-hidden" aria-hidden="true">
  <div class="cursor-ring"><span class="cursor-label">{t.work.view}</span></div>
  <div class="cursor-dot"></div>
</div>

<!-- Preloader (first visit per session) -->
<div class="preloader" aria-hidden="true">
  <div class="preloader-bar"></div>
  <div class="preloader-inner">
    <div>
      <div class="preloader-name"><span class="line"><span>kevin<span>rebuilds.</span></span></span></div>
      <div class="preloader-sub">{t.preloader}</div>
    </div>
    <div class="preloader-count">0</div>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <a class="brand" href={home} aria-label="Kevin Rebuilds, home" data-cursor="link">kevin<span>rebuilds.</span></a>
    <nav class="nav" aria-label={t.nav.label}>
      {t.nav.items.map(([href, label]) => <a href={href} data-nav>{label}</a>)}
    </nav>
    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label={t.nav.langLabel}>
        <a href="/" hreflang="nl" lang="nl" aria-current={lang === "nl" ? "true" : "false"} data-lang-link aria-label="Nederlands">NL</a>
        <a href="/en/" hreflang="en" lang="en" aria-current={lang === "en" ? "true" : "false"} data-lang-link aria-label="English">EN</a>
      </div>
      <a class="btn btn--primary btn--sm header-cta magnetic" href="#contact">
        {t.nav.cta}
        <Icon name="arrow-up-right" class="arrow" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-open={t.nav.menu} data-close={t.nav.close}>
        <i></i><span>{t.nav.menu}</span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu">
  <nav aria-label={t.nav.label}>
    {t.nav.items.map(([href, label], i) => (
      <a href={href} data-menu-link><small>0{i + 1}</small>{label}</a>
    ))}
    <a href="#contact" data-menu-link><small>06</small>Contact</a>
  </nav>
  <div class="mobile-menu-foot">
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    <span>{t.hero.location}</span>
  </div>
</div>

<main id="main">
  <!-- HERO ------------------------------------------------------------- -->
  <section class="hero" data-chapter="dark" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-grid"></div>
      <div class="orb orb--1"></div>
      <div class="orb orb--2"></div>
      <div class="orb orb--3"></div>
    </div>
    <div class="container" style="display:flex;flex-direction:column;flex:1">
      <div class="hero-top">
        <span class="status" data-hero-fade><i aria-hidden="true"></i>{t.hero.status}</span>
        <div class="hero-meta" data-hero-fade>
          {t.hero.tags.join(" · ")}<br />{t.hero.location}
        </div>
      </div>

      <h1 class="display hero-title" id="hero-title">
        {t.hero.lines.map((line, i) => (
          <span class="line">
            <span class={i === t.hero.accentLine ? "serif" : undefined}>{line}</span>
          </span>
        ))}
      </h1>

      <div class="hero-bottom">
        <div class="hero-intro" data-hero-fade>
          <p>{t.hero.intro}</p>
          <div class="hero-ctas">
            <a class="btn btn--cobalt magnetic" href="#contact">
              {t.hero.primary}
              <Icon name="arrow-up-right" class="arrow" />
            </a>
            <a class="btn btn--ghost magnetic" href="#werk">
              {t.hero.secondary}
              <Icon name="arrow-down" class="arrow" />
            </a>
          </div>
        </div>
        <a class="hero-card" href="#over" data-hero-fade data-cursor="link">
          <Image src={head} alt="" width={112} height={112} loading="eager" fetchpriority="high" />
          <div>
            <strong>Kevin</strong>
            <span>{lang === "nl" ? "Webdesigner & developer" : "Web designer & developer"}</span>
          </div>
        </a>
      </div>
    </div>
    <a class="spin-badge" href="#werk" data-cursor="link" aria-label={t.hero.secondary}>
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <defs><path id="badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
        <text><textPath href="#badge-circle">{`${t.preloader} · ${t.hero.secondary} · `}</textPath></text>
      </svg>
      <span class="spin-badge-core"></span>
    </a>
    <span class="scroll-cue" aria-hidden="true">{t.hero.scroll}</span>
  </section>

  <!-- MARQUEE ---------------------------------------------------------- -->
  <div class="marquee" data-chapter="dark" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {t.marquee.map((word) => (
            <span class="marquee-item">
              <span class="marquee-text">{word}</span>
              <Icon name="star" class="marquee-star" />
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <p class="sr-only">{t.marquee.join(", ")}</p>

  <!-- STATEMENT -------------------------------------------------------- -->
  <section class="section statement" data-chapter="dark" aria-label={lang === "nl" ? "Mijn visie" : "My view"}>
    <div class="container">
      <p data-split-words>{t.statement}</p>
      <div class="statement-foot" data-reveal>
        <div class="statement-sign">
          <Image src={head} alt="" width={128} height={128} />
          <div>
            <strong>Kevin</strong>
            {lang === "nl" ? "Oprichter, Kevin Rebuilds" : "Founder, Kevin Rebuilds"}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES --------------------------------------------------------- -->
  <section class="section services" id="diensten" data-chapter="light" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <span class="eyebrow" data-reveal>{t.services.eyebrow}</span>
          <h2 class="h2" id="services-title" style="margin-top:24px" data-lines>
            <span class="line"><span>{t.services.title[0]}</span></span>
            <span class="line"><span class="serif">{t.services.title[1]}</span></span>
          </h2>
        </div>
        <p class="lead" data-reveal>{t.services.intro}</p>
      </div>

      <div class="services-stack">
        {t.services.items.map((s, i) => (
          <article class="svc" style={`--i:${i}`} aria-labelledby={`svc-${i}`}>
            <div class="svc-head">
              <span class="svc-no">{s.no} / 03</span>
              <h3 id={`svc-${i}`}>{s.title}</h3>
              <p class="svc-lead">{s.lead}</p>
              <div class="svc-tags">
                {s.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
            <div class="svc-body">
              <div class="svc-visual" aria-hidden="true">
                {serviceViz[i] === "browser" && (
                  <div class="viz-browser"><span></span><span></span><span></span><span></span></div>
                )}
                {serviceViz[i] === "app" && (
                  <div class="viz-app"><span></span><span></span><span></span></div>
                )}
                {serviceViz[i] === "flow" && (
                  <div class="viz-flow">
                    <span><Icon name="inbox" /></span><i></i>
                    <span><Icon name="calendar" /></span><i></i>
                    <span><Icon name="mail" /></span><i></i>
                    <span><Icon name="check" /></span>
                  </div>
                )}
              </div>
              <h4>{t.services.includesLabel}</h4>
              <ul class="svc-list">
                {s.includes.map((item) => (
                  <li><Icon name="check" />{item}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <div class="services-foot" data-reveal>
        <p>
          {lang === "nl"
            ? "Twijfel je wat je nodig hebt? Geen probleem. In een kort gesprek zoeken we samen uit wat het meest oplevert."
            : "Not sure what you need? No problem. In a short call we'll work out together what delivers the most."}
        </p>
        <a class="btn btn--primary magnetic" href="#contact">
          {t.hero.primary}
          <Icon name="arrow-up-right" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- WORK ------------------------------------------------------------- -->
  <section class="section work" id="werk" data-chapter="dark" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-reveal>{t.work.eyebrow}</span>
        <h2 class="h2" id="work-title" data-lines>
          <span class="line"><span>{t.work.title[0]}</span></span>
          <span class="line"><span class="serif accent">{t.work.title[1]}</span></span>
        </h2>
      </div>

      <article class="case" aria-labelledby="case-title">
        <a class="case-visual" href={t.work.project.url} target="_blank" rel="noopener" data-cursor="view" aria-label={`${t.work.project.cta}: ${t.work.project.name}`}>
          <div class="case-inner" data-parallax>
            <div class="browser">
              <div class="browser-bar"><i></i><i></i><i></i><small>{t.work.project.domain}</small></div>
              <Image src={differentHair} alt={t.work.project.alt} widths={[720, 1440]} sizes="(min-width: 1480px) 1380px, 94vw" />
            </div>
          </div>
        </a>

        <div class="case-meta">
          <div class="case-title" data-reveal>
            <span class="badge badge--live">{t.work.live}</span>
            <h3 id="case-title">{t.work.project.name}</h3>
          </div>
          <div class="case-text" data-reveal>
            <p>{t.work.project.summary}</p>
            <a class="project-link" href={t.work.project.url} target="_blank" rel="noopener">
              {t.work.project.cta}<Icon name="arrow-up-right" class="arrow" />
            </a>
          </div>
          <dl class="case-facts" data-reveal>
            <div><dt>{t.work.clientLabel}</dt><dd>{t.work.project.client}</dd></div>
            <div>
              <dt>{t.work.rolesLabel}</dt>
              <dd><ul class="case-roles">{t.work.project.roles.map((r) => <li class="tag">{r}</li>)}</ul></dd>
            </div>
          </dl>
        </div>
      </article>

      <div class="case-next" data-reveal>
        <div>
          <h3>{t.work.next.title}</h3>
          <p>{t.work.next.text}</p>
        </div>
        <a class="btn btn--cobalt magnetic" href="#contact">
          {t.work.next.cta}<Icon name="arrow-up-right" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- WHY (bento) ------------------------------------------------------ -->
  <section class="section why" data-chapter="dark" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow" data-reveal>{t.why.eyebrow}</span>
        <h2 class="h2" id="why-title" data-lines>
          <span class="line"><span>{t.why.title[0]}</span></span>
          <span class="line"><span class="serif accent">{t.why.title[1]}</span></span>
        </h2>
      </div>
      <div class="bento" data-bento>
        <article class="bento-card" data-reveal>
          <span class="bento-icon"><Icon name={whyIcons[whyDirect.k]} /></span>
          <div><h3>{whyDirect.title}</h3><p>{whyDirect.text}</p></div>
        </article>
        <article class="bento-card bento-speed" data-reveal>
          <div>
            <span class="bento-icon" style="margin-bottom:28px"><Icon name={whyIcons[whySpeed.k]} /></span>
            <h3>{whySpeed.title}</h3>
            <p>{whySpeed.text}</p>
          </div>
          <div class="gauge" data-gauge>
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle class="track" cx="60" cy="60" r="52"></circle>
              <circle class="value" cx="60" cy="60" r="52"></circle>
            </svg>
            <div class="gauge-label">
              <strong data-count-to="95" data-count-suffix="">{whySpeed.stat}</strong>
              <span>{whySpeed.statLabel}</span>
            </div>
          </div>
        </article>
        <article class="bento-card" data-reveal>
          <span class="bento-icon"><Icon name={whyIcons[whyMobile.k]} /></span>
          <div><h3>{whyMobile.title}</h3><p>{whyMobile.text}</p></div>
        </article>
        <article class="bento-card" data-reveal>
          <div class="search-mock" aria-hidden="true">
            <Icon name="search" /><span data-typer={searchPhrase}>{searchPhrase}</span><span class="caret"></span>
          </div>
          <div><h3>{whySeo.title}</h3><p>{whySeo.text}</p></div>
        </article>
        <article class="bento-card" data-reveal>
          <span class="bento-icon"><Icon name={whyIcons[whyHonest.k]} /></span>
          <div><h3>{whyHonest.title}</h3><p>{whyHonest.text}</p></div>
        </article>
        <article class="bento-card bento-wide" data-reveal>
          <div class="lang-flip" aria-hidden="true">
            <span data-flip-words="Hallo.|Hello.|Hallo.|Hello.">Hallo.</span><br />
            <span class="serif">NL / EN</span>
          </div>
          <div>
            <span class="bento-icon" style="margin-bottom:20px"><Icon name={whyIcons[whyLang.k]} /></span>
            <h3>{whyLang.title}</h3>
            <p>{whyLang.text}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- PROCESS ---------------------------------------------------------- -->
  <section class="section process" id="werkwijze" data-chapter="light" aria-labelledby="process-title">
    <div class="container process-grid">
      <div class="process-sticky">
        <span class="eyebrow" data-reveal>{t.process.eyebrow}</span>
        <h2 class="h2" id="process-title" style="margin-top:24px" data-lines>
          <span class="line"><span>{t.process.title[0]}</span></span>
          <span class="line"><span class="serif accent">{t.process.title[1]}</span></span>
        </h2>
        <a class="btn btn--primary magnetic" href="#contact" style="margin-top:40px" data-reveal>
          {t.hero.primary}<Icon name="arrow-up-right" class="arrow" />
        </a>
      </div>
      <ol class="steps" data-steps>
        <span class="steps-line" aria-hidden="true"><span></span></span>
        {t.process.steps.map((s, i) => (
          <li class="step">
            <span class="step-no" aria-hidden="true">0{i + 1}</span>
            <h3>{s.title}<span class="tag">{s.meta}</span></h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ABOUT ------------------------------------------------------------ -->
  <section class="section about" id="over" data-chapter="dark" aria-labelledby="about-title">
    <div class="container about-grid">
      <figure class="about-photo" data-clip-reveal>
        <Image src={head} alt={t.about.photoAlt} widths={[440, 880]} sizes="(min-width: 480px) 440px, 90vw" data-parallax-y />
        <figcaption>{t.about.caption}</figcaption>
      </figure>
      <div class="about-copy">
        <span class="eyebrow" data-reveal>{t.about.eyebrow}</span>
        <h2 class="h2" id="about-title" data-lines>
          <span class="line"><span>{t.about.title[0]}</span></span>
          <span class="line"><span class="serif accent">{t.about.title[1]}</span></span>
        </h2>
        {t.about.paragraphs.map((p) => <p data-reveal>{p}</p>)}
        <div class="facts" data-reveal>
          {t.about.facts.map(([n, label]) => (
            <div><strong data-count-to={n}>{n}</strong><span>{label}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -------------------------------------------------------------- -->
  <section class="section faq" id="faq" data-chapter="light" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="process-sticky">
        <span class="eyebrow" data-reveal>{t.faq.eyebrow}</span>
        <h2 class="h2" id="faq-title" style="margin-top:24px" data-lines>
          <span class="line"><span>{t.faq.title[0]}</span></span>
          <span class="line"><span class="serif accent">{t.faq.title[1]}</span></span>
        </h2>
      </div>
      <div class="faq-list">
        {t.faq.items.map(([q, a], i) => (
          <div class={`faq-item ${i === 0 ? "is-open" : ""}`} data-reveal>
            <h3>
              <button class="faq-q" type="button" aria-expanded={i === 0 ? "true" : "false"} aria-controls={`faq-${i}`} id={`faq-q-${i}`}>
                {q}<i aria-hidden="true"></i>
              </button>
            </h3>
            <div class="faq-a" id={`faq-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
              <div><p>{a}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT ---------------------------------------------------------- -->
  <section class="section contact" id="contact" data-chapter="accent" aria-labelledby="contact-title">
    <div class="container">
      <span class="eyebrow" data-reveal>{t.contact.eyebrow}</span>
      <h2 class="display contact-big" id="contact-title" data-lines>
        <span class="line"><span>{t.contact.big[0]}</span></span>
        <span class="line"><span class="serif">{t.contact.big[1]}</span></span>
        <span class="line"><span>{t.contact.big[2]}</span></span>
      </h2>
      <div class="contact-grid">
        <div class="contact-side" data-reveal>
          <p class="lead">{t.contact.intro}</p>
          <div>
            <span class="eyebrow">{t.contact.direct}</span>
            <div class="email-big" style="margin-top:14px">
              <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
              <button class="icon-btn" type="button" data-copy-email={EMAIL} aria-label={t.contact.copy}>
                <Icon name="copy" />
              </button>
            </div>
            <p class="copy-status" role="status" data-copy-status data-ok={t.contact.copied} data-fail={t.contact.copyFailed}></p>
          </div>
          <div class="hero-ctas">
            <a class="btn btn--primary magnetic" href={`mailto:${EMAIL}?subject=${encodeURIComponent(t.contact.subject)}`}>
              <Icon name="mail" class="arrow" />{lang === "nl" ? "Mail me direct" : "Email me directly"}
            </a>
            <a class="btn btn--ghost magnetic" href={FIVERR} target="_blank" rel="noopener">
              {t.contact.fiverr}<Icon name="arrow-up-right" class="arrow" />
            </a>
          </div>
        </div>

        <form class="contact-form" data-contact-form data-reveal data-subject={t.contact.subject} novalidate>
          <h3>{t.contact.formTitle}</h3>
          <div class="honeypot" aria-hidden="true"><label>Website<input name="_honey" tabindex="-1" autocomplete="off" /></label></div>
          <fieldset>
            <legend>{t.contact.typeLegend}</legend>
            <div class="chips">
              {t.contact.types.map((type, i) => (
                <label><input type="radio" name="project" value={type} checked={i === 0} /><span>{type}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="fields-2">
            <label>{t.contact.name}<input class="input" name="name" autocomplete="name" placeholder={t.contact.namePh} required /></label>
            <label>{t.contact.email}<input class="input" name="email" type="email" autocomplete="email" placeholder={t.contact.emailPh} required /></label>
          </div>
          <label>{t.contact.message}<textarea class="textarea" name="message" rows="5" placeholder={t.contact.messagePh} required></textarea></label>
          <div class="form-foot">
            <small>{t.contact.privacy}</small>
            <button class="btn btn--cobalt" type="submit" data-contact-submit data-label={t.contact.send} data-sending={t.contact.sending} data-sent={t.contact.sent}>
              <span data-contact-label>{t.contact.send}</span><Icon name="send" class="arrow" />
            </button>
          </div>
          <p class="form-status" role="status" aria-live="polite" data-contact-status data-success={t.contact.success} data-error={t.contact.error} data-email={EMAIL}></p>
        </form>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div>
        <a class="brand" href={home}>kevin<span>rebuilds.</span></a>
        <p style="margin-top:16px">{t.footer.tagline}</p>
      </div>
      <div>
        <h4>{lang === "nl" ? "Navigatie" : "Navigate"}</h4>
        <ul>{t.nav.items.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={`mailto:${EMAIL}`}>E-mail</a></li>
          <li><a href={FIVERR} target="_blank" rel="noopener">Fiverr</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.local}</h4>
        <p class="clock" data-clock>--:--</p>
        <p>{t.hero.location}</p>
      </div>
    </div>
    <div class="wordmark" aria-hidden="true" data-wordmark>kevinrebuilds<span>.</span></div>
    <div class="footer-bottom">
      <span>© {year} Kevin Rebuilds. {t.footer.rights}</span>
      <a href="#main" data-to-top>{t.footer.top}<Icon name="arrow-up" class="arrow" /></a>
    </div>
  </div>
</footer>

<script>
  import "../scripts/main";
</script>
