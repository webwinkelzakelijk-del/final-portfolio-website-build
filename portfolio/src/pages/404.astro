---
import "../styles/global.css";
---

<!doctype html>
<html lang="nl" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 | Kevin Rebuilds</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=DM+Sans:opsz,wght@9..40,400..700&family=Instrument+Serif:ital@1&display=swap" />
  </head>
  <body>
    <main class="container" style="min-height:100svh;display:grid;align-content:center;gap:32px">
      <span class="eyebrow">404</span>
      <h1 class="display" style="font-size:clamp(3rem,12vw,10rem)">
        Deze pagina<br /><span class="serif accent">bestaat niet.</span>
      </h1>
      <p class="lead">This page doesn't exist. Terug naar de homepage?</p>
      <div class="hero-ctas">
        <a class="btn btn--cobalt" href="/">Naar home</a>
        <a class="btn btn--ghost" href="/en/">English home</a>
      </div>
    </main>
  </body>
</html>
